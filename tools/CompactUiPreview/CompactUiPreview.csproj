<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Developer tool only (not part of the solution, the installer or CI).
    Renders the compact dock's shared DockPainter code with fixture states so
    reviewers can see each visual state without launching the Windows app.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\BKE_RENDER_DOCK\CompactUi\DockJobFeed.cs" Link="CompactUi\DockJobFeed.cs" />
    <Compile Include="..\..\BKE_RENDER_DOCK\CompactUi\DockTheme.cs" Link="CompactUi\DockTheme.cs" />
    <Compile Include="..\..\BKE_RENDER_DOCK\CompactUi\DockPainter.cs" Link="CompactUi\DockPainter.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Preview tool only. On Linux/macOS this needs libgdiplus. -->
    <PackageReference Include="System.Drawing.Common" Version="6.0.0" />
    <RuntimeHostConfigurationOption Include="System.Drawing.EnableUnixSupport" Value="true" />
  </ItemGroup>
</Project>
